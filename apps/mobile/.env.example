# Copy to .env in this folder (git ignores it).
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so only public
# values belong here: the Supabase URL and publishable key (rules.md section 3).
#
# Local stack: `pnpm supabase status` prints the API URL and publishable key.
# A phone can't reach 127.0.0.1 on your PC; use the PC's LAN IP instead.
# Dev/prod: Supabase dashboard > Project Settings > API Keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PowerSync instance URL. Local Docker service: http://<PC LAN IP>:8080
EXPO_PUBLIC_POWERSYNC_URL=
